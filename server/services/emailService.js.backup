const nodemailer = require('nodemailer');
const pool = require('../config/db');

class EmailService {
  constructor() {
    this.transporter = null;
    this.initializeTransporter();
  }

  initializeTransporter() {
    if (process.env.EMAIL_USER && process.env.EMAIL_PASSWORD) {
      this.transporter = nodemailer.createTransport({
        service: 'gmail',
        auth: {
          user: process.env.EMAIL_USER,
          pass: process.env.EMAIL_PASSWORD
        }
      });
    }
  }

  async sendEmail(to, subject, html) {
    if (!this.transporter) {
      console.log('Email service not configured');
      return;
    }

    try {
      const mailOptions = {
        from: process.env.EMAIL_USER,
        to,
        subject,
        html
      };

      const result = await this.transporter.sendMail(mailOptions);
      console.log('Email sent successfully:', result.messageId);
      return result;
    } catch (error) {
      console.error('Error sending email:', error);
      throw error;
    }
  }

  async sendGradeApprovedEmail(userId, grades) {
    try {
      // Get user details
      const userResult = await pool.query(
        'SELECT email, full_name FROM users WHERE user_id = $1',
        [userId]
      );

      if (userResult.rows.length === 0) return;

      const user = userResult.rows[0];
      const subject = 'Bảng điểm đã được phê duyệt';
      
      let gradesList = '';
      grades.forEach(grade => {
        gradesList += `<li>${grade.subject_name}: ${grade.total_score}/10</li>`;
      });

      const html = `
        <h2>Thông báo phê duyệt bảng điểm</h2>
        <p>Xin chào ${user.full_name},</p>
        <p>Bảng điểm của bạn đã được phê duyệt:</p>
        <ul>${gradesList}</ul>
        <p>Vui lòng đăng nhập vào hệ thống để xem chi tiết.</p>
        <p>Trân trọng,<br>Phòng Đào tạo</p>
      `;

      await this.sendEmail(user.email, subject, html);
    } catch (error) {
      console.error('Error sending grade approved email:', error);
    }
  }

  async sendRequestProcessedEmail(userId, requestType, status, adminResponse) {
    try {
      // Get user details
      const userResult = await pool.query(
        'SELECT email, full_name FROM users WHERE user_id = $1',
        [userId]
      );

      if (userResult.rows.length === 0) return;

      const user = userResult.rows[0];
      const requestTypeMap = {
        'REVIEW': 'Phúc khảo',
        'RESERVE': 'Bảo lưu',
        'RETAKE': 'Học lại'
      };

      const statusMap = {
        'APPROVED': 'được phê duyệt',
        'REJECTED': 'bị từ chối'
      };

      const subject = `Yêu cầu ${requestTypeMap[requestType]} ${statusMap[status]}`;
      
      const html = `
        <h2>Thông báo xử lý yêu cầu</h2>
        <p>Xin chào ${user.full_name},</p>
        <p>Yêu cầu ${requestTypeMap[requestType]} của bạn đã ${statusMap[status]}.</p>
        ${adminResponse ? `<p><strong>Phản hồi từ Admin:</strong> ${adminResponse}</p>` : ''}
        <p>Vui lòng đăng nhập vào hệ thống để xem chi tiết.</p>
        <p>Trân trọng,<br>Phòng Đào tạo</p>
      `;

      await this.sendEmail(user.email, subject, html);
    } catch (error) {
      console.error('Error sending request processed email:', error);
    }
  }

  async sendUpcomingClassEmail(lecturerId, classInfo) {
    try {
      // Get lecturer details
      const lecturerResult = await pool.query(
        `SELECT u.email, u.full_name 
         FROM lecturers l 
         JOIN users u ON l.user_id = u.user_id 
         WHERE l.lecturer_id = $1`,
        [lecturerId]
      );

      if (lecturerResult.rows.length === 0) return;

      const lecturer = lecturerResult.rows[0];
      const subject = 'Nhắc nhở lịch dạy sắp tới';
      
      const html = `
        <h2>Lịch dạy sắp tới</h2>
        <p>Xin chào ${lecturer.full_name},</p>
        <p>Bạn có lớp học sắp tới:</p>
        <ul>
          <li><strong>Môn học:</strong> ${classInfo.subject_name}</li>
          <li><strong>Lớp:</strong> ${classInfo.section_code}</li>
          <li><strong>Thời gian:</strong> ${classInfo.day_name}, tiết ${classInfo.periods}</li>
          <li><strong>Phòng:</strong> ${classInfo.room}</li>
          <li><strong>Số sinh viên:</strong> ${classInfo.student_count}</li>
        </ul>
        <p>Vui lòng chuẩn bị đầy đủ cho buổi học.</p>
        <p>Trân trọng,<br>Phòng Đào tạo</p>
      `;

      await this.sendEmail(lecturer.email, subject, html);
    } catch (error) {
      console.error('Error sending upcoming class email:', error);
    }
  }

  async sendUpcomingScheduleEmail(userId, scheduleInfo) {
    try {
      // Get user details
      const userResult = await pool.query(
        'SELECT email, full_name FROM users WHERE user_id = $1',
        [userId]
      );

      if (userResult.rows.length === 0) return;

      const user = userResult.rows[0];
      const subject = 'Nhắc nhở lịch học sắp tới';
      
      const html = `
        <h2>Lịch học sắp tới</h2>
        <p>Xin chào ${user.full_name},</p>
        <p>Bạn có lớp học sắp tới:</p>
        <ul>
          <li><strong>Môn học:</strong> ${scheduleInfo.subject_name}</li>
          <li><strong>Lớp:</strong> ${scheduleInfo.section_code}</li>
          <li><strong>Thời gian:</strong> ${scheduleInfo.day_name}, tiết ${scheduleInfo.periods}</li>
          <li><strong>Phòng:</strong> ${scheduleInfo.room}</li>
          <li><strong>Giảng viên:</strong> ${scheduleInfo.lecturer_name}</li>
        </ul>
        <p>Vui lòng chuẩn bị đầy đủ cho buổi học.</p>
        <p>Trân trọng,<br>Phòng Đào tạo</p>
      `;

      await this.sendEmail(user.email, subject, html);
    } catch (error) {
      console.error('Error sending upcoming schedule email:', error);
    }
  }
}

module.exports = new EmailService();